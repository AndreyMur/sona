# OdiRouter
ODIROUTER_API_KEY=sk-replace-me
ODIROUTER_BASE_URL=https://api.odirouter.ai/v1

# Admin API (remote config / tier management)
ADMIN_TOKEN=replace-with-a-long-random-string

# Runtime (docker-compose overrides DATA_DIR to /data)
DATA_DIR=data
ENVIRONMENT=production
LOG_LEVEL=INFO

# Models
STT_MODEL_STANDARD=openai/gpt-4o-mini-transcribe
STT_MODEL_PRO=openai/gpt-4o-transcribe
STT_MODEL_FALLBACK=openai/whisper-large-v3
NLU_MODEL_PRIMARY=google/gemini-3.8-flash
NLU_MODEL_FALLBACK=openai/gpt-4o
NLU_CONFIDENCE_THRESHOLD=0.7

# Limits
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=300
FREE_MONTHLY_OPERATIONS=30
MONTHLY_COST_LIMIT_USD=2.0
MAX_AUDIO_BYTES=10485760

# HTTPS (used by Caddy for Let's Encrypt)
ACME_EMAIL=admin@aidailyplanner.ru
